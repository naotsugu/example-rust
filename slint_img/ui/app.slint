export component AppWindow inherits Window {
    width: 500px;
    height: 500px;
    title: "Slint Image Pixel Edit Example";

    in-out property <image> target-image;
    // Fired on mouse down and on every mouse move while the button is pressed.
    // Coordinates are in image pixel space and may lie outside the image
    // (e.g. while dragging past the edge); the Rust side clips them.
    callback stroke-point(int, int);
    // Fired when the mouse button is released (or the gesture is cancelled)
    callback stroke-end();

    Rectangle {
        width: 100%;
        height: 100%;

        // Image size in pixels
        property <float> img-w: root.target-image.width;
        property <float> img-h: root.target-image.height;

        // Scale factor equivalent to `image-fit: contain`
        property <float> scale: (img-w > 0 && img-h > 0)
            ? min(self.width / 1px / img-w, self.height / 1px / img-h)
            : 1;

        // Top-left corner of the displayed image (letterbox margins)
        property <length> offset-x: (self.width - img-w * scale * 1px) / 2;
        property <length> offset-y: (self.height - img-h * scale * 1px) / 2;

        // Image pixel under the mouse cursor
        property <int> px: Math.floor((touch.mouse-x - offset-x) / (scale * 1px));
        property <int> py: Math.floor((touch.mouse-y - offset-y) / (scale * 1px));

        Image {
            width: 100%;
            height: 100%;
            source: root.target-image;
            image-fit: contain;
        }

        touch := TouchArea {
            width: 100%;
            height: 100%;

            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    root.stroke-point(parent.px, parent.py);
                } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                    root.stroke-end();
                }
            }

            // Called only while a button is held down
            moved => {
                root.stroke-point(parent.px, parent.py);
            }
        }
    }
}
